#!/bin/bash
# Compila e instala Arquitec DSP (fork de Guitarix) en la versión que pide os/MOTOR_VERSION.
# Lo usan os/instalar.sh y os/post-actualizacion.sh: una sola forma de compilar el motor.
#
#   compilar-motor              # optimizado para ESTE procesador (se compila en el propio equipo)
#   compilar-motor --generico   # corre en cualquier PC x86-64: para la imagen USB, que se arma en
#                               # otra PC (optimizado en una con AVX2, no arrancaría en una sin)
#
# PS_RAIZ: dónde está el programa (default /opt/pedalsistema).
set -euo pipefail
RAIZ="${PS_RAIZ:-/opt/pedalsistema}"
ESTADO_DIR=/var/lib/pedalsistema
FUENTES=/usr/local/src/arquitec-dsp
# De dónde bajar el código: el fork primero; si no se puede (es privado: sin usuario y clave git
# falla al instante, nunca se queda esperando), el Guitarix original, que tiene los mismos commits
# mientras el fork no agregue cambios propios.
REPOS_MOTOR=(https://github.com/egimenez-bot/arquitec-dsp.git https://github.com/brummer10/guitarix.git)
export GIT_TERMINAL_PROMPT=0
OPT=(--optimization)
[ "${1:-}" = --generico ] && OPT=()
pedido="$(tr -d '[:space:]' < "$RAIZ/os/MOTOR_VERSION")"
export DEBIAN_FRONTEND=noninteractive

# Dependencias de compilación: salen de las fuentes (deb-src) de Debian.
if ! apt-get build-dep -s guitarix >/dev/null 2>&1; then
  cat > /etc/apt/sources.list.d/pedalsistema-fuentes.sources <<EOF
Types: deb-src
URIs: http://deb.debian.org/debian
Suites: $(. /etc/os-release; echo "$VERSION_CODENAME")
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOF
  apt-get update
fi
apt-get build-dep -y guitarix

mkdir -p "$ESTADO_DIR" /usr/local/src
tiene_commit() { git -C "$FUENTES" cat-file -e "$pedido^{commit}" 2>/dev/null; }
bajar() {
  local url
  for url in "${REPOS_MOTOR[@]}"; do
    if [ ! -d "$FUENTES/.git" ]; then
      rm -rf "$FUENTES"
      git clone --quiet "$url" "$FUENTES" || continue
    else
      git -C "$FUENTES" fetch --quiet --tags "$url" '+refs/heads/*:refs/remotes/bajado/*' || continue
    fi
    tiene_commit && { echo "motor: código de $url"; return 0; }
  done
  return 1
}
# Si el commit ya está (imagen, o un intento anterior), no hace falta internet.
tiene_commit || bajar || { echo "No se pudo bajar el motor $pedido (¿sin internet?)" >&2; exit 1; }
git -C "$FUENTES" checkout --quiet --detach "$pedido"
# NAM (NeuralAmpModelerCore) y RTNeural vienen como submódulos: sin ellos no compila.
git -C "$FUENTES" submodule --quiet update --init --recursive
cd "$FUENTES/trunk"
./waf configure --prefix=/usr --includeresampler --includeconvolver "${OPT[@]}"
./waf build -j"$(nproc)"
./waf install
echo "$pedido" > "$ESTADO_DIR/motor-version"
if [ "${#OPT[@]}" = 0 ]; then
  touch "$ESTADO_DIR/motor-generico"
else
  rm -f "$ESTADO_DIR/motor-generico"
fi
echo "motor: Arquitec DSP $pedido instalado (${OPT[*]:-genérico x86-64})"
